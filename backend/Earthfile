VERSION 0.8
deps:
  FROM golang:1.25.1
  WORKDIR /src
  COPY go.mod go.sum ./
  RUN go mod download

build:
  FROM +deps
  ## schema.sql is gonna be embedded
  COPY *.go schema.sql ./
  COPY --dir internal ./
  RUN --mount=type=cache,id=go-build-cache,target=/root/.cache/go-build \
      GOOS=linux go build -o backend main.go
  SAVE ARTIFACT ./backend

run:
  FROM debian:bookworm
  LABEL org.opencontainers.image.source = 'https://codeberg.org/schnelles_geraet/website-else/src/branch/main/backend'
  ARG tag
  WORKDIR /root
  COPY +build/backend .
  EXPOSE 3000
  ENTRYPOINT ["./backend"]
  SAVE IMAGE --push hmaierdev/website-else-backend:$tag
